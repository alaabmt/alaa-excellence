{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tamayuz10x-lpp-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tamayuz10x-lpp",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
